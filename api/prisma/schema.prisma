generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  USER
  CREATOR
  MODERATOR
  ADMIN
}
enum Visibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
  PREMIUM
}
enum StoryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  REMOVED
}
enum CreationType {
  AUDIO
  TEXT
}
enum SubscriptionTier {
  FREE
  CREATOR
  PRO
}
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String?
  name String
  username String @unique
  role Role @default(USER)
  avatarUrl String?
  bio String?
  preferredGenres String[] @default([])
  preferredCreationType CreationType?
  onboardingCompleted Boolean @default(false)
  subscriptionTier SubscriptionTier @default(FREE)
  createdAt DateTime @default(now())
  stories Story[]
  refreshTokens RefreshToken[]
  followsFollowing Follow[] @relation("following")
  followsFollowers Follow[] @relation("followers")
  ideas Idea[]
  ideaUpvotes IdeaUpvote[]
  ideaBids IdeaBid[]
}
model Story {
  id String @id @default(cuid())
  authorId String
  author User @relation(fields:[authorId],references:[id])
  title String
  body String?
  audioUrl String?
  coverUrl String?
  summary String?
  tags String[]
  genre String?
  visibility Visibility @default(PUBLIC)
  status StoryStatus @default(DRAFT)
  premium Boolean @default(false)
  creationType CreationType @default(TEXT)
  durationSeconds Int?
  refinementStatus String @default("NOT_REQUESTED")
  readCount Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comments Comment[]
  likes Like[]
  bookmarks Bookmark[]
}
model RefreshToken {
  id String @id @default(cuid())
  tokenHash String
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
model Follow {
  followerId String
  followingId String
  follower User @relation("following",fields:[followerId],references:[id],onDelete:Cascade)
  following User @relation("followers",fields:[followingId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@id([followerId,followingId])
}
model Like {
  userId String
  storyId String
  story Story @relation(fields:[storyId],references:[id],onDelete:Cascade)
  @@id([userId,storyId])
}
model Bookmark {
  userId String
  storyId String
  story Story @relation(fields:[storyId],references:[id],onDelete:Cascade)
  @@id([userId,storyId])
}
model Comment {
  id String @id @default(cuid())
  body String
  authorId String
  storyId String
  story Story @relation(fields:[storyId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
}
enum IdeaStatus {
  PENDING_PAYMENT
  PUBLISHED
  ARCHIVED
  REMOVED
}
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
model Idea {
  id String @id @default(cuid())
  authorId String
  author User @relation(fields:[authorId],references:[id],onDelete:Cascade)
  title String
  description String
  category String
  mvpDetails String?
  status IdeaStatus @default(PENDING_PAYMENT)
  currentBidCents Int @default(100)
  upvoteCount Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  upvotes IdeaUpvote[]
  bids IdeaBid[]
  @@index([status,category,currentBidCents])
}
model IdeaUpvote {
  ideaId String
  userId String
  idea Idea @relation(fields:[ideaId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@id([ideaId,userId])
}
model IdeaBid {
  id String @id @default(cuid())
  ideaId String
  bidderId String
  idea Idea @relation(fields:[ideaId],references:[id],onDelete:Cascade)
  bidder User @relation(fields:[bidderId],references:[id],onDelete:Cascade)
  amountCents Int
  status PaymentStatus @default(PENDING)
  dodoSessionId String? @unique
  dodoPaymentId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ideaId,status,amountCents])
}
model PaymentWebhookEvent {
  id String @id
  type String
  receivedAt DateTime @default(now())
}
